# Deprecated: previously auto-started live on boot. Now ignored — start/stop live auto manually
# from /polymarket.html (Plan 按钮) or POST /api/polymarket/live-auto/start|stop.
POLYMARKET_LIVE_AUTO_ENABLED=false
# Deprecated companion of LIVE_AUTO_ENABLED (no longer used for boot auto-start)
POLYMARKET_LIVE_AUTO_PLAN=plan1
# POLYMARKET_LIVE_CONFIRM_PHRASE 已废弃，不再使用
# Use a dedicated small wallet. Do not commit real secrets.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=0
# Generate these locally with: npm run polymarket:derive-key
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---- IBKR 美股量化页面(/ibkr.html)----
# 行情默认来自 Yahoo Finance 公开接口,无需密钥;实盘需自行接 IBKR 网关。
STOCK_ACCOUNT_EQUITY_USD=100000
# 佣金计划:lite(免佣) | proFixed(固定式) | proTiered(阶梯式)
IBKR_COMMISSION_MODEL=proFixed
# 默认策略模型:rsi2 | sma_cross | ema_cross | macd | bollinger | momentum
STOCK_DEFAULT_MODEL=rsi2
STOCK_CANDLE_RANGE=1y
STOCK_SYMBOLS=AAPL,MSFT,NVDA,SPY
STOCK_WATCHLIST_DIR=D:\Obsidian仓库\Kawaii的仓库\投资\股票\List\美股\KawaiiList
STOCK_PAPER_STARTING_CASH=0
STOCK_PAPER_TICK_INTERVAL_MS=60000
# 单票上限(占净值)。模拟盘优先按策略风险仓位下单,再以此封顶。
STOCK_PAPER_POSITION_FRACTION=0.1
# 始终保留的现金比例,避免一轮 buy 信号把本金买光。
STOCK_PAPER_CASH_FLOOR_PCT=0.2
STOCK_PAPER_MIN_ORDER_USD=25
# Finnhub 免费 API(持仓投研助手的财报日历+公司新闻)。去 https://finnhub.io/ 申请后填入。
# 未配置时技术面扫描仍可用,只是没有财报/新闻催化。
FINNHUB_API_KEY=
FINNHUB_NEWS_LOOKBACK_DAYS=7
FINNHUB_EARNINGS_HORIZON_DAYS=21
