PORT=3000

# Robinhood Crypto API credentials. Keep these on the server only.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY_BASE64=
ROBINHOOD_PUBLIC_KEY_BASE64=

# Default is false. The UI can draft orders, but the backend refuses live orders
# until this is explicitly true.
ENABLE_LIVE_TRADING=false

# Account equity used for position sizing and fee-drag projections.
ACCOUNT_EQUITY_USD=10000

# Market data source for UI + paper trading: binance | robinhood | mock
MARKET_DATA_SOURCE=binance
MARKET_KLINE_INTERVAL=1h
MARKET_KLINE_LIMIT=120
MARKET_SPARKLINE_LIMIT=24
BINANCE_API_BASE=https://data-api.binance.vision,https://api.binance.com

# Paper trading defaults (also editable in UI before start)
PAPER_STARTING_CASH=0
PAPER_INITIAL_HOLDINGS=
PAPER_TICK_INTERVAL_MS=30000
PAPER_POSITION_FRACTION=0.2
PAPER_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,DOGE-USD

# 15m prediction outcome records. In Docker this path is mounted to /records.
PREDICTION_RECORDS_ENABLED=true
PREDICTION_RECORD_DIR=/records
PREDICTION_RECORD_POLL_INTERVAL_MS=5000
PREDICTION_RECORD_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD

# 5m PM early-direction recorder (not a full trade signal)
FIVE_MINUTE_DECISION_LOCK_MIN_ELAPSED_PCT=0.08
FIVE_MINUTE_DECISION_LOCK_DEFAULT_ELAPSED_PCT=0.12
FIVE_MINUTE_DECISION_LOCK_MAX_ELAPSED_PCT=0.25
FIVE_MINUTE_DECISION_MIN_PM_GAP=0.03
FIVE_MINUTE_DECISION_TERMINAL_LOCK_ELAPSED_PCT=0.90
FIVE_MINUTE_DECISION_STRONG_PM_GAP=0.60
FIVE_MINUTE_DECISION_NORMAL_PM_GAP=0.30
FIVE_MINUTE_DECISION_LOW_WINRATE_HOUR_GUARD_ENABLED=true
FIVE_MINUTE_DECISION_LOW_WINRATE_PRIMARY_HOUR=13
FIVE_MINUTE_DECISION_LOW_WINRATE_PRIMARY_MIN_PM_GAP=0.35
FIVE_MINUTE_DECISION_LOW_WINRATE_PRIMARY_MIN_CONFIDENCE=0.66
FIVE_MINUTE_DECISION_MIN_MARKET_QUALITY=0.45
FIVE_MINUTE_DECISION_MIN_STABLE_SECONDS=15
FIFTEEN_MINUTE_DECISION_LOCK_MIN_ELAPSED_PCT=0.08
FIFTEEN_MINUTE_DECISION_LOCK_DEFAULT_ELAPSED_PCT=0.12
FIFTEEN_MINUTE_DECISION_LOCK_MAX_ELAPSED_PCT=0.25
FIFTEEN_MINUTE_DECISION_MIN_PM_GAP=0.03
FIFTEEN_MINUTE_DECISION_STRONG_PM_GAP=0.60
FIFTEEN_MINUTE_DECISION_NORMAL_PM_GAP=0.30
FIFTEEN_MINUTE_DECISION_LOW_WINRATE_HOUR_GUARD_ENABLED=true
FIFTEEN_MINUTE_DECISION_LOW_WINRATE_PRIMARY_HOUR=6
FIFTEEN_MINUTE_DECISION_LOW_WINRATE_PRIMARY_MIN_PM_GAP=0.40
FIFTEEN_MINUTE_DECISION_LOW_WINRATE_PRIMARY_MIN_CONFIDENCE=0.68
FIFTEEN_MINUTE_DECISION_LOW_WINRATE_SECONDARY_HOUR=20
FIFTEEN_MINUTE_DECISION_LOW_WINRATE_SECONDARY_MIN_PM_GAP=0.30
FIFTEEN_MINUTE_DECISION_LOW_WINRATE_SECONDARY_MIN_CONFIDENCE=0.65
FIFTEEN_MINUTE_DECISION_MIN_MARKET_QUALITY=0.45
FIFTEEN_MINUTE_DECISION_MIN_STABLE_SECONDS=15
FIVE_MINUTE_RECORD_UNLOCKED_WINDOWS=true
FIVE_MINUTE_RECORD_TECH_AND_COMPOSITE=true

# Next-slot prediction lock (later/stricter than display lock; write once per source window)
# Soft lock: wait for stronger certainty. Hard deadline: force lock before window ends.
# Shared defaults (override per-timeframe with FIVE_MINUTE_/FIFTEEN_MINUTE_ prefix if needed)
NEXT_SLOT_PREDICTION_LOCK_MIN_ELAPSED_PCT=0.5
NEXT_SLOT_PREDICTION_LOCK_MIN_PM_GAP=0.06
NEXT_SLOT_PREDICTION_LOCK_MIN_STRENGTH=normal
NEXT_SLOT_PREDICTION_ALLOW_WEAK=true
NEXT_SLOT_PREDICTION_LOCK_WEAK_MIN_ELAPSED_PCT=0.6
NEXT_SLOT_PREDICTION_LOCK_HARD_MIN_ELAPSED_PCT=0.9
# 5m default 30s / 15m default 60s if unset per-timeframe
NEXT_SLOT_PREDICTION_LOCK_HARD_MAX_REMAINING_SEC=30
# FIVE_MINUTE_NEXT_SLOT_PREDICTION_LOCK_HARD_MAX_REMAINING_SEC=30
# FIFTEEN_MINUTE_NEXT_SLOT_PREDICTION_LOCK_HARD_MAX_REMAINING_SEC=60
# FIVE_MINUTE_NEXT_SLOT_PREDICTION_LOCK_MIN_ELAPSED_PCT=0.5
# FIFTEEN_MINUTE_NEXT_SLOT_PREDICTION_LOCK_MIN_ELAPSED_PCT=0.5

# Plan2 uses current 5m PM lock for direction/exit judgment (default on; not a hard entry gate)
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_ENABLED=true
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_REQUIRE_LOCK=false
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_WEAK_SCALE=0.5
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_ALLOW_PROBE_ON_CONFLICT=true
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_ALLOW_PROBE_ON_UNSTABLE=true
POLYMARKET_PLAN2_PAPER_FIVE_MINUTE_LOCK_ENABLED=true
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_STATS_LOOKBACK_DAYS=14
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_STATS_MIN_SAMPLES=5
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_MIN_HISTORICAL_ACCURACY=0.52
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_DIRECTION_BOOST_STRONG=0.06
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_DIRECTION_BOOST_NORMAL=0.04
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_DIRECTION_BOOST_WEAK=0.02
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_CONFLICT_PREFER_MIN_WEIGHT=0.7
POLYMARKET_PLAN2_FIVE_MINUTE_LOCK_STRONG_TP_OFFSET_BONUS=0.02
POLYMARKET_PLAN2_EXIT_LOCK_ALIGNED_HOLD_DELTA=-0.04
POLYMARKET_PLAN2_EXIT_LOCK_CONFLICT_REVERSE_DELTA=-0.06
POLYMARKET_PLAN2_EXIT_LOCK_STRONG_CONFLICT_REVERSE_DELTA=-0.08

# Hourly monitor (writes to PREDICTION_RECORD_DIR/monitor/)
HOURLY_MONITOR_ENABLED=true
HOURLY_MONITOR_INTERVAL_MS=3600000
# HOURLY_MONITOR_DIR=  # defaults to PREDICTION_RECORD_DIR

# Polymarket read-only sentiment for BTC 15m direction (no login / no trading)
POLYMARKET_ENABLED=true
POLYMARKET_BLEND_ENABLED=true
POLYMARKET_BTC_TIMEFRAME=15m
# International paper line. Keep this false to stop paper plans.
# Do not point Gamma/CLOB at polymarket.us; that line is POLYMARKET_US_*.
POLYMARKET_INTL_PAPER_ENABLED=true
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_DATA_BASE=https://data-api.polymarket.com

# US line (polymarket.us). Public reads only; scanners never place orders.
# Standing authorization: the bot sends the limit order when a SIGNAL is pending.
# No per-trade chat confirmation. Size stays about $2–5.
POLYMARKET_US_ENABLED=false
POLYMARKET_US_SITE_BASE=https://polymarket.us
POLYMARKET_US_GATEWAY_BASE=https://gateway.polymarket.us/v1
# POLYMARKET_US_LEDGER_DIR=/workspace/polymarket-ledger
# POLYMARKET_US_IGNORE_WINDOW=1
POLYMARKET_REQUEST_TIMEOUT_MS=12000
POLYMARKET_DEFAULT_ORDER_USD=5
POLYMARKET_MAX_ORDER_USD=500
POLYMARKET_DAILY_MAX_LOSS_USD=25
POLYMARKET_PAPER_STARTING_CASH=500
POLYMARKET_SIZING_BASE_PRINCIPAL=500
# tier1 基准 = 净值 × 比例（推荐）；$500 时约 15m $27.5 / 5m $12.5
POLYMARKET_ORDER_PCT_15M=0.055
POLYMARKET_ORDER_PCT_5M=0.025
# 单笔 tier1 上限 = 净值 × 此比例（应 ≥ ORDER_PCT_15M）
POLYMARKET_MAX_ORDER_EQUITY_PCT=0.12
# 实盘统一二次上限：结合历史手续费后 PnL、保本胜率、样本可信度和当前信号质量动态缩放
POLYMARKET_LIVE_ADAPTIVE_CAP_ENABLED=true
POLYMARKET_LIVE_ADAPTIVE_CAP_BASE_EQUITY_PCT=0.08
POLYMARKET_LIVE_ADAPTIVE_CAP_FLOOR_EQUITY_PCT=0.03
POLYMARKET_LIVE_ADAPTIVE_CAP_MAX_EQUITY_PCT=0.10
POLYMARKET_LIVE_ADAPTIVE_CAP_MIN_SAMPLES=12
POLYMARKET_LIVE_ADAPTIVE_CAP_LOOKBACK_DAYS=30
# 模拟盘只按 20% 权重参与，避免模拟成交质量覆盖真实亏损
POLYMARKET_LIVE_ADAPTIVE_CAP_PAPER_WEIGHT=0.20
POLYMARKET_MAX_TOTAL_OPEN_EXPOSURE_PCT=0.55
POLYMARKET_MAX_TIMEFRAME_OPEN_EXPOSURE_PCT=0.55
# 兼容旧配置：固定美元基准（会被 ORDER_PCT 覆盖；勿与 ORDER_PCT 同时改）
POLYMARKET_ORDER_USD_15M=40
POLYMARKET_ORDER_USD_5M=25
# Edge 经济学：edge = 置信度 − 入场价；tier 分层入场取代单一 edge 门槛
POLYMARKET_MIN_EDGE_5M=0.06
POLYMARKET_MIN_EDGE_15M=0.04
POLYMARKET_MIN_MARKET_QUALITY=0.40
# 最低置信度门槛（全局默认，Plan1/Plan2 有独立门槛）
POLYMARKET_MIN_CONFIDENCE_5M=0.58
POLYMARKET_MIN_CONFIDENCE_15M=0.56
# Plan1 — 综合信号 + 中途 TP/SL + tier 分层入场（能交易版 v2）
POLYMARKET_PLAN1_MIN_MARKET_QUALITY=0.40
POLYMARKET_PLAN1_SYMBOLS=BTC-USD,ETH-USD
POLYMARKET_PLAN2_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD
# Plan2 跨币：BTC 方向加成 + 本币更便宜时 cross_follow 小仓跟随
POLYMARKET_PLAN2_CROSS_SYMBOL_ENABLED=true
POLYMARKET_PLAN2_CROSS_SYMBOL_MIN_LEADER_CONFIDENCE=0.62
POLYMARKET_PLAN2_CROSS_SYMBOL_ALIGN_BOOST=0.02
POLYMARKET_PLAN2_CROSS_FOLLOW_ENABLED=true
POLYMARKET_PLAN2_CROSS_FOLLOW_MIN_LEADER_CONFIDENCE=0.64
POLYMARKET_PLAN2_CROSS_FOLLOW_MIN_DISCOUNT=0.04
POLYMARKET_PLAN2_CROSS_FOLLOW_MAX_OPPOSING_GAP=0.10
POLYMARKET_PLAN2_CROSS_FOLLOW_MIN_PRICE=0.40
POLYMARKET_PLAN2_CROSS_FOLLOW_MAX_PRICE=0.85
POLYMARKET_PLAN2_CROSS_FOLLOW_MIN_ELAPSED_PCT=0.10
POLYMARKET_PLAN2_CROSS_FOLLOW_MAX_ELAPSED_PCT=0.72
POLYMARKET_PLAN2_CROSS_FOLLOW_MAX_REVERSE_DISTANCE_BPS=6
POLYMARKET_PLAN2_CROSS_FOLLOW_MIN_QUALITY=0.35
POLYMARKET_PLAN2_CROSS_FOLLOW_SIZE_MULTIPLIER=0.35
POLYMARKET_PLAN1_MIN_EDGE_5M=0.025
POLYMARKET_PLAN1_MIN_EDGE_15M=0.02
POLYMARKET_PLAN1_MIN_CONFIDENCE=0.58
POLYMARKET_PLAN1_BASKET_CONFLICT_PROBE_ENABLED=false
POLYMARKET_PLAN1_MAX_ENTRY_PRICE=0.64
POLYMARKET_PLAN1_MAX_ENTRY_PRICE_5M=0.64
POLYMARKET_PLAN1_MAX_ENTRY_PRICE_15M=0.64
POLYMARKET_PLAN1_MIN_ENTRY_PRICE=0.55
POLYMARKET_PLAN1_MIN_ENTRY_PRICE_5M=0.55
POLYMARKET_PLAN1_MIN_ENTRY_PRICE_15M=0.55
POLYMARKET_PLAN1_ENTRY_MIN_ELAPSED_PCT=0.08
POLYMARKET_PLAN1_ENTRY_MAX_ELAPSED_PCT=0.75
POLYMARKET_PLAN1_ENTRY_MIN_ELAPSED_PCT_5M=0.12
POLYMARKET_PLAN1_ENTRY_MAX_ELAPSED_PCT_5M=0.68
POLYMARKET_PLAN1_ENTRY_MIN_ELAPSED_PCT_15M=0.08
POLYMARKET_PLAN1_ENTRY_MAX_ELAPSED_PCT_15M=0.75
POLYMARKET_PLAN1_TAKE_PROFIT_OFFSET=0.14
POLYMARKET_PLAN1_STOP_LOSS_OFFSET=0.10
# 入场价 >= 50% 时，止损线固定在此价位（设为 0 则仅用相对偏移）
POLYMARKET_STOP_LOSS_ABSOLUTE_FLOOR=0.50
POLYMARKET_PLAN1_TIME_STOP_REMAINING_PCT=0.25
POLYMARKET_PLAN1_DIRECTION_FLIP_ENABLED=true
POLYMARKET_PLAN1_DIRECTION_FLIP_ENABLED_5M=false
POLYMARKET_PLAN1_DIRECTION_FLIP_ENABLED_15M=true
POLYMARKET_PLAN1_FLIP_COOLDOWN_MS=120000
POLYMARKET_PLAN1_FLIP_MIN_HOLD_MS=90000
POLYMARKET_PLAN1_FLIP_MIN_CONFIDENCE=0.64
POLYMARKET_PLAN1_FLIP_MIN_EDGE=0.035
POLYMARKET_PLAN1_FLIP_MAX_FLOATING_LOSS_PCT=0.25
POLYMARKET_PLAN1_FLIP_MAX_ELAPSED_PCT=0.80
POLYMARKET_PLAN1_EDGE_CONFIDENCE_MODE=tech_heavy
POLYMARKET_PLAN1_TECH_EDGE_WEIGHT=0.75
POLYMARKET_PLAN1_BASKET_CONFLICT_PROBE_MULTIPLIER=0.15
POLYMARKET_PLAN1_5M_PATH_GUARD_ENABLED=true
POLYMARKET_PLAN1_HISTORY_HIERARCHY_ENABLED=true
POLYMARKET_PLAN1_LATE_CAPTURE_ENABLED=false
POLYMARKET_PLAN1_LATE_CAPTURE_MIN_PRICE=0.82
POLYMARKET_PLAN1_LATE_CAPTURE_MAX_PRICE=0.94
POLYMARKET_PLAN1_LATE_CAPTURE_MIN_MARKET_QUALITY=0.42
POLYMARKET_PLAN1_LATE_CAPTURE_MID_SIZE_MULTIPLIER=0.55
POLYMARKET_PLAN1_LATE_CAPTURE_HIGH_SIZE_MULTIPLIER=0.25
POLYMARKET_PLAN1_OPPOSITE_HEDGE_ENABLED=true
POLYMARKET_PLAN1_OPPOSITE_HEDGE_MAX_PRICE=0.15
POLYMARKET_PLAN1_OPPOSITE_HEDGE_SIZE_PCT=0.05
# 概率校准 / 历史胜率门控 / 市场状态 / 组合风险
POLYMARKET_CONFIDENCE_CALIBRATION_ENABLED=true
POLYMARKET_CONFIDENCE_MIN_BUCKET_SAMPLES=20
POLYMARKET_CALIBRATION_LOOKBACK_DAYS=45
POLYMARKET_HISTORY_WINRATE_GATE_ENABLED=true
POLYMARKET_HISTORY_WINRATE_MARGIN=0.02
POLYMARKET_HISTORY_WINRATE_REQUIRE_CALIBRATION=false
# 亏损归因反馈门控：近期同类可规避亏损占比过高 → skip/降仓（冷启动放行）
POLYMARKET_LOSS_REASON_GATE_ENABLED=true
POLYMARKET_LOSS_REASON_GATE_MIN_SAMPLES=12
POLYMARKET_LOSS_REASON_GATE_LOOKBACK_DAYS=14
POLYMARKET_LOSS_REASON_GATE_MAX_LOSS_RATE=0.55
POLYMARKET_LOSS_REASON_GATE_REQUIRE_SAMPLES=false
POLYMARKET_LOSS_REASON_GATE_SIZE_SCALE_ENABLED=true
POLYMARKET_LOSS_REASON_GATE_SIZE_SCALE_FLOOR=0.5
POLYMARKET_LOSS_REASON_HIGH_ENTRY_PRICE=0.85
POLYMARKET_LOSS_REASON_SHORT_HOLD_MS=90000
# 分币胜率奖赏仓位（Plan1/2/5）：按开启币种历史胜率排名分配权重
# mean_preserving：cashPct_i = base * (w_i/sum(w)) * n，平均≈base，第1名>base，末名<base
# fixed_pool：cashPct_i = base * (w_i/sum(w))，四币同时满仓总敞口≈base
POLYMARKET_SYMBOL_WR_SIZING_ENABLED=true
POLYMARKET_SYMBOL_WR_RANK_WEIGHTS=4,3,2,1
POLYMARKET_SYMBOL_WR_MIN_SAMPLES=10
POLYMARKET_SYMBOL_WR_LOOKBACK_DAYS=30
POLYMARKET_SYMBOL_WR_SIZING_MODE=mean_preserving
# SQLite 统计库：持续写入锁定与已结算订单，供 Plan1/2 校准与胜率门控
STATS_DB_ENABLED=true
STATS_DB_PATH=data/polymarket-stats.db
# direction_judgments：胜率计算页每次刷新写入 5m/15m 方向判断，窗口结算后回填对错
POLYMARKET_PLAN3_BAND_STATS_GATE_ENABLED=true
POLYMARKET_PLAN3_BAND_STATS_MIN_SAMPLES=30
POLYMARKET_PLAN3_BAND_STATS_MARGIN=0.005
POLYMARKET_PLAN3_BAND_STATS_LOOKBACK_DAYS=30
# 实盘决策优先 live-only 档位统计；样本不足回退 all。EV 用预期成交价（含 bump）
POLYMARKET_PLAN3_BAND_STATS_PREFER_LIVE=true
POLYMARKET_PLAN3_BAND_STATS_FILL_BUMP_STEPS=2
POLYMARKET_REGIME_FILTER_ENABLED=true
POLYMARKET_CHOP_FILTER_ENABLED=true
POLYMARKET_CHOP_MAX_DISTANCE_BPS=4
POLYMARKET_CHOP_MIN_DIRECTION_FLIPS=3
POLYMARKET_CHOP_MAIN_SIZE_SCALE=0
POLYMARKET_CHOP_PROBE_SIZE_SCALE=0.2
POLYMARKET_GLOBAL_EXPOSURE_CAP_ENABLED=true
# total_only 仅限制全部实盘未结算总仓位，不启用同窗口/单周期细分拦截
POLYMARKET_GLOBAL_EXPOSURE_MODE=total_only
POLYMARKET_GLOBAL_SLOT_DIRECTION_MAX_EXPOSURE_PCT=0.15
POLYMARKET_GLOBAL_TIMEFRAME_MAX_EXPOSURE_PCT=0.25
POLYMARKET_GLOBAL_TOTAL_BTC_MARKET_EXPOSURE_PCT=0.75
POLYMARKET_KELLY_CAP_ENABLED=true
POLYMARKET_KELLY_FRACTION=0.25

# 连赢加仓 / 连亏减仓（入场 sizing；paper+live 各自按已结算 pnl streak；不改止损路径）
# 默认保守：连赢 +12%/级 cap 1.5x；连亏 −22%/级 floor 0.4x
POLYMARKET_STREAK_SIZING_ENABLED=true
POLYMARKET_STREAK_SIZING_WIN_STEP_PCT=0.12
POLYMARKET_STREAK_SIZING_WIN_MAX_LEVELS=4
POLYMARKET_STREAK_SIZING_WIN_CAP=1.5
POLYMARKET_STREAK_SIZING_LOSS_STEP_PCT=0.22
POLYMARKET_STREAK_SIZING_LOSS_MAX_LEVELS=4
POLYMARKET_STREAK_SIZING_LOSS_FLOOR=0.4
# clamp=缩到最小单；skip=低于最小单则跳过噪声单
POLYMARKET_STREAK_SIZING_BELOW_MIN_MODE=clamp
# 每 plan 可选覆盖（true/false）；留空则跟随全局
# POLYMARKET_PLAN1_STREAK_SIZING_ENABLED=
# Plan2 纸盘关闭连赢加仓，避免放大高价区不对称亏损
POLYMARKET_PLAN2_STREAK_SIZING_ENABLED=false
# POLYMARKET_PLAN2_5_STREAK_SIZING_ENABLED=
# POLYMARKET_PLAN2_6_STREAK_SIZING_ENABLED=
# POLYMARKET_PLAN3_STREAK_SIZING_ENABLED=
# POLYMARKET_PLAN3_5_STREAK_SIZING_ENABLED=
# POLYMARKET_PLAN3_6_STREAK_SIZING_ENABLED=
# POLYMARKET_PLAN4_STREAK_SIZING_ENABLED=
# POLYMARKET_PLAN5_STREAK_SIZING_ENABLED=

POLYMARKET_PLAN2_PROBE_UPDATE_SCORE_ENABLED=true
POLYMARKET_PLAN2_PROBE_UPDATE_SCORE_MIN=0.65
# 实盘关闭探针小单（~$1 试探单）；模拟盘仍可用 POLYMARKET_PLAN2_PROBE_ENABLED
POLYMARKET_PLAN2_LIVE_PROBE_ENABLED=false
POLYMARKET_PLAN2_LIVE_BLOCKED_RETRY_ENABLED=true
# Plan2/2.5 激进成交：下单前拉盘口改价 + 更多 FAK bump + 5m 亚秒重试
POLYMARKET_PLAN2_LIVE_PREFLIGHT_ENABLED=true
# 热门侧崩价回撤拦截：阻止 90¢ 信号在盘口塌到廉价侧时仍追单
POLYMARKET_PLAN2_LIVE_MAX_ADVERSE_PRICE_DROP_ABS=0.15
POLYMARKET_PLAN2_LIVE_MAX_ADVERSE_PRICE_DROP_PCT=0.30
POLYMARKET_PLAN2_LIVE_FAK_BUMP_STEPS=8
POLYMARKET_PLAN2_LIVE_FAK_BUMP_STEPS_5M=10
POLYMARKET_PLAN2_LIVE_IMMEDIATE_ONLY_5M=true
POLYMARKET_PLAN2_LIVE_BLOCKED_RETRY_AFTER_MS=500
POLYMARKET_PLAN2_LIVE_BLOCKED_RETRY_AFTER_MS_5M=300
POLYMARKET_PLAN2_LIVE_UNFILLED_RETRY_AFTER_MS=2000
POLYMARKET_PLAN2_LIVE_UNFILLED_RETRY_AFTER_MS_5M=1500
POLYMARKET_PLAN2_LIVE_BLOCKED_RETRY_MAX_PER_KEY=16
POLYMARKET_PLAN2_LIVE_UNFILLED_RETRY_MAX_PER_KEY=10
POLYMARKET_PLAN2_LATE_CAPTURE_REQUIRE_CALIBRATED_EDGE=true
POLYMARKET_PLAN2_LATE_CAPTURE_SAFETY_MARGIN=0.025
# Plan2 — 动态 TP/SL + tier 分层入场（>0.78 禁止）
POLYMARKET_PLAN2_ENTRY_MIN_PRICE=0.35
POLYMARKET_PLAN2_ENTRY_MAX_PRICE=0.78
POLYMARKET_PLAN2_MIN_CONFIDENCE=0.63
POLYMARKET_PLAN2_MIN_EDGE=0.08
POLYMARKET_PLAN2_ENTRY_MIN_ELAPSED_PCT=0.08
POLYMARKET_PLAN2_MAX_ENTRY_ELAPSED_PCT=0.78
POLYMARKET_PLAN2_MAX_ENTRY_ELAPSED_PCT_5M=0.78
POLYMARKET_PLAN2_LATE_CAPTURE_MIN_DISTANCE_BPS=5
POLYMARKET_PLAN2_ULTRA_LATE_CAPTURE_MAX_SECONDS_5M=60
POLYMARKET_PLAN2_TAKE_PROFIT_OFFSET=0.20
POLYMARKET_PLAN2_TAKE_PROFIT_ENABLED=false
# 回撤止盈不要默认写进 Plan2 族；Plan13 本版也不止盈
POLYMARKET_PLAN2_TRAILING_TAKE_PROFIT_ENABLED=false
POLYMARKET_PLAN2_TRAILING_TAKE_PROFIT_OFFSET=0.10
# 纸盘优先及时止损；TP 可关/慢，SL 必须开
POLYMARKET_PLAN2_STOP_LOSS_ENABLED=true
POLYMARKET_PLAN2_STOP_LOSS_OFFSET=0.08
# 关闭 dynamic hold，避免延迟止损
